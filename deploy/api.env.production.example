# ============================================================================
#  abc-pay-api (Laravel) — à copier vers  abc-pay-api/.env
#  Remplace TOUTES les valeurs CHANGE_ME et les domaines.
# ============================================================================

APP_NAME="abc pay"
APP_ENV=production
APP_KEY=                       # généré par `php artisan key:generate`
APP_DEBUG=false                # JAMAIS true en prod (fuite de stack/secrets)
APP_URL=https://api.abcpay.cd
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=warning              # pas de debug en prod

# --- Base de données : PostgreSQL (cible du projet, cf. db/schema.sql) --------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=abcpay
DB_USERNAME=abcpay
DB_PASSWORD=CHANGE_ME_MOT_DE_PASSE_FORT

# --- Sessions / cache / files (table SQL : présentes dans les migrations) -----
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database           # ⤷ Redis recommandé plus tard (rate-limiters + cache)

# --- CORS : origine(s) EXACTE(s) du front (séparées par des virgules) ---------
CORS_ALLOWED_ORIGINS=https://app.abcpay.cd
FRONTEND_URL=https://app.abcpay.cd

# --- JWT applicatif (RS256) ---------------------------------------------------
# Les clés sont lues depuis storage/app/keys/jwt_private.pem + jwt_public.pem
# (générées sur le serveur, HORS dépôt). Voir README §5.
JWT_ALGO=RS256
JWT_ISSUER=abcpay
JWT_ACCESS_TTL=900             # 15 min
JWT_REFRESH_TTL=2592000        # 30 jours

# --- E-mail (reçus / notifications) — à brancher sur ton SMTP -----------------
MAIL_MAILER=log                # 'log' pour démarrer ; SMTP réel ensuite
MAIL_FROM_ADDRESS="no-reply@abcpay.cd"
MAIL_FROM_NAME="abc pay"
