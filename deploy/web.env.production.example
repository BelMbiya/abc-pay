# ============================================================================
#  abc-pay-web (Next.js) — à copier vers  abc-pay-web/.env.production
# ============================================================================
#  ⚠️ IMPORTANT : les variables NEXT_PUBLIC_* sont INLINÉES AU MOMENT DU BUILD.
#  Ce fichier doit donc exister AVANT `npm run build`. Un changement de valeur
#  impose un nouveau build (pas seulement un redémarrage).
# ============================================================================

NODE_ENV=production

# URL publique de l'API (le sous-domaine servi par Nginx → Laravel).
NEXT_PUBLIC_API_URL=https://api.abcpay.cd

# --- OTP / Firebase Phone Auth -------------------------------------------------
# false = MODE DÉMO : n'importe quels 6 chiffres valident l'OTP (aucun SMS réel).
# Passe à true UNIQUEMENT quand le projet Firebase est configuré (SMS + reCAPTCHA
# + numéros autorisés). Renseigne alors les 6 clés publiques ci-dessous.
NEXT_PUBLIC_FIREBASE_ENABLED=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
