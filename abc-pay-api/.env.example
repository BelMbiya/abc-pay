APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- abc pay ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Firebase Phone Auth (OTP). enabled=true (+ provider Phone activé en console) →
# vérification réelle du jeton (FirebasePhoneTokenVerifier). Défaut false → fake (dev).
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=abc-pay-70f11

# PostgreSQL (production / cible). En dev local : sqlite par défaut.
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=abc_pay
# DB_USERNAME=abc_pay
# DB_PASSWORD=

# OFF par défaut : sans clés, abc pay reste en mode démo (confirmation immédiate).
# Checkout (encaissement)
# Transfer (reversement)
# Base publique HTTPS pour les webhooks (notify_url). Ex : https://api.abcpay.cd

# --- Passerelle CinetPay (API Aurore, RDC) ---
# OFF par défaut : sans clés, abc pay reste en mode démo (confirmation immédiate).
CINETPAY_ENABLED=false
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
# CINETPAY_BASE_URL=https://api.cinetpay.net/v1
CINETPAY_PAYMENT_METHOD=
CINETPAY_TRANSFER_METHOD=
CINETPAY_NOTIFY_BASE=
CINETPAY_FRONT_URL=http://localhost:3000
# TLS : bundle CA embarqué par défaut (storage/app/cacert.pem). En prod Linux, laisser vide.
# CINETPAY_CA_BUNDLE=
CINETPAY_VERIFY_SSL=true
