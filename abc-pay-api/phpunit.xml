<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Passerelle CinetPay TOUJOURS OFF en test (déterminisme, indépendant du .env).
             CinetPayIntegrationTest l'active explicitement via config() + Http::fake(). -->
        <env name="CINETPAY_ENABLED" value="false"/>
        <!-- Reversement automatique (transfert) OFF en test ; activé explicitement là où testé. -->
        <env name="CINETPAY_TRANSFER_ENABLED" value="false"/>
        <!-- Passerelle par défaut FIXÉE en test (indépendant du .env) ; Araka OFF.
             ArakaIntegrationTest sélectionne Araka explicitement via config(). -->
        <env name="PAYMENT_GATEWAY" value="cinetpay"/>
        <env name="ARAKA_ENABLED" value="false"/>
        <!-- Décaissement Araka OFF en test ; activé explicitement dans ArakaIntegrationTest. -->
        <env name="ARAKA_TRANSFER_ENABLED" value="false"/>
        <!-- Montant minimum CinetPay OFF en test (activé explicitement là où testé). -->
        <env name="CINETPAY_MIN_AMOUNT" value="0"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
